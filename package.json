{
  "name": "dsh-purge",
  "version": "2.0.10",
  "description": "DeepSeek Harness 破甲插件（深度分支，维护收敛）— 已停止跟进宿主更新，推荐改用社区版 dsh-purge Community",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "fix": "node scripts/fix-dsh-purge.mjs",
    "check": "node scripts/fix-dsh-purge.mjs --check",
    "test": "node tests/run.mjs",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "author": "xxy0722",
  "contributors": [
    "小杨 (YuJunZhiXue) — 原始项目 dsh-purge"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "llm-security",
    "harness-security",
    "red-team",
    "prompt-eval",
    "jailbreak",
    "prefill",
    "agent",
    "网络安全",
    "红队评测"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxy0722/dsh-purge-deep.git"
  },
  "homepage": "https://github.com/xxy0722/dsh-purge-deep#readme",
  "bugs": {
    "url": "https://github.com/xxy0722/dsh-purge-deep/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/xxy0722/dsh-purge-deep/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/xxy0722/dsh-purge-deep/archive/refs/heads/main.zip",
      "git": "https://github.com/xxy0722/dsh-purge-deep.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.1"
}
